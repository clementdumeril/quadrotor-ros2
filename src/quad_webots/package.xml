<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>quad_webots</name>
  <version>0.1.0</version>
  <description>Webots world, Mavic 2 Pro driver plugin (state, rate loop, mixer) and launch files.</description>
  <maintainer email="clementdumeril@gmail.com">Clément Dumeril</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>pluginlib</depend>
  <depend>webots_ros2_driver</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>quad_interfaces</depend>
  <depend>eigen</depend>
  <exec_depend>quad_control</exec_depend>
  <exec_depend>quad_mission</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
