digraph ros {
  rankdir=LR; node [fontname=Helvetica, fontsize=11];
  "/mavic" [shape=ellipse, style=filled, fillcolor="#dbe9f6"];
  "/mavic" -> "/quad/imu";
  "/mavic" -> "/quad/motor_speeds";
  "/mavic" -> "/quad/odom";
  "/mavic" -> "/remove_urdf_robot";
  "/mavic" -> "/tf";
  "/clock" -> "/mavic";
  "/quad/cmd/motor_speeds_raw" -> "/mavic";
  "/quad/cmd/rates_thrust" -> "/mavic";
  "/Ros2Supervisor/Ros2Supervisor" [shape=ellipse, style=filled, fillcolor="#dbe9f6"];
  "/Ros2Supervisor/Ros2Supervisor" -> "/clock";
  "/position_controller" [shape=ellipse, style=filled, fillcolor="#dbe9f6"];
  "/position_controller" -> "/quad/cmd/rates_thrust";
  "/clock" -> "/position_controller";
  "/quad/odom" -> "/position_controller";
  "/quad/setpoint" -> "/position_controller";
  "/quad/controller/enable" [shape=octagon, style=filled, fillcolor="#fde9c9"];
  "/quad/controller/enable" -> "/position_controller" [style=dashed, label="service"];
  "/mission" [shape=ellipse, style=filled, fillcolor="#dbe9f6"];
  "/mission" -> "/quad/setpoint";
  "/clock" -> "/mission";
  "/cmd_vel" -> "/mission";
  "/quad/odom" -> "/mission";
  "/quad/land" [shape=octagon, style=filled, fillcolor="#fde9c9"];
  "/quad/land" -> "/mission" [style=dashed, label="service"];
  "/quad/takeoff" [shape=octagon, style=filled, fillcolor="#fde9c9"];
  "/quad/takeoff" -> "/mission" [style=dashed, label="service"];
  "/quad/cmd/rates_thrust" [shape=box, style=filled, fillcolor="#e8f3e3"];
  "/clock" [shape=box, style=filled, fillcolor="#e8f3e3"];
  "/quad/imu" [shape=box, style=filled, fillcolor="#e8f3e3"];
  "/quad/cmd/motor_speeds_raw" [shape=box, style=filled, fillcolor="#e8f3e3"];
  "/cmd_vel" [shape=box, style=filled, fillcolor="#e8f3e3"];
  "/quad/motor_speeds" [shape=box, style=filled, fillcolor="#e8f3e3"];
  "/tf" [shape=box, style=filled, fillcolor="#e8f3e3"];
  "/remove_urdf_robot" [shape=box, style=filled, fillcolor="#e8f3e3"];
  "/quad/setpoint" [shape=box, style=filled, fillcolor="#e8f3e3"];
  "/quad/odom" [shape=box, style=filled, fillcolor="#e8f3e3"];
  "/quad/go_to" [shape=doubleoctagon, style=filled, fillcolor="#f6d6d6"];
  "/quad/go_to" -> "/mission" [style=dashed, label="action"];
}
